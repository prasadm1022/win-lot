{
  "name": "win-lot",
  "version": "2.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Sri Lankan lottery (NLB + DLB) history, statistics and next-draw picks as a static Next.js site on the Cloudflare free plan",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/export-public.ts",
    "build": "next build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "update": "tsx scripts/update.ts",
    "update:backfill-dlb": "tsx scripts/update.ts --backfill-dlb",
    "jackpots": "tsx scripts/jackpots.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
