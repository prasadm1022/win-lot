# Google AdSense, build-time only (set as Cloudflare Workers Builds variables). Public IDs, not secrets.
# Leave NEXT_PUBLIC_ADSENSE_CLIENT empty and ads are fully off (no script, no ad space, no ads.txt).
# Publisher ID, format ca-pub-<digits>
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit ID of the top banner, digits only; empty = no top ad space
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
# Ad unit ID of the left rail (screens 1600 px and wider), digits only; empty = no left ad space
NEXT_PUBLIC_ADSENSE_SLOT_LEFT=
# Ad unit ID of the right rail (screens 1600 px and wider), digits only; empty = no right ad space
NEXT_PUBLIC_ADSENSE_SLOT_RIGHT=
# Ad unit ID of the bottom banner, digits only; empty = no bottom ad space
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
